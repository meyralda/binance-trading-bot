from __future__ import annotations

import os
import time
from datetime import datetime
from typing import Dict, List, Optional

import pandas as pd

from config import (
    ENABLE_LIVE_TRADING,
    ENABLE_PAPER_TRADING,
    SYMBOL,
    MARKET_SCAN_INTERVAL,
    POSITION_CHECK_INTERVAL,
    MAX_OPEN_POSITIONS,
    MIN_SIGNAL_STRENGTH,
    MIN_POSITION_SIZE_USDT,
    STOP_LOSS_PERCENT,
    TAKE_PROFIT_PERCENT,
)
from binance_client import BinanceClient
from position_manager import PositionManager
from trade_logger import TradeLogger


class BotEngine:
    def __init__(self):
        self.client = BinanceClient()
        self.logger = TradeLogger()
        self.positions = PositionManager(logger=self.logger)
        self.scan_state = {}

    def _safe_float(self, value) -> float:
        try:
            return float(value)
        except (TypeError, ValueError):
            return 0.0

    def _ema(self, series: pd.Series, period: int) -> pd.Series:
        return series.ewm(span=period, adjust=False).mean()

    def _rsi(self, series: pd.Series, period: int = 14) -> pd.Series:
        delta = series.diff()
        gain = delta.where(delta > 0, 0)
        loss = -delta.where(delta < 0, 0)
        avg_gain = gain.ewm(com=period - 1, min_periods=period, adjust=False).mean()
        avg_loss = loss.ewm(com=period - 1, min_periods=period, adjust=False).mean()
        rs = avg_gain / avg_loss.replace(0, float("nan"))
        return 100 - (100 / (1 + rs)).fillna(50)

    def _generate_signal(self, df: pd.DataFrame) -> Dict:
        if df.empty or "close" not in df.columns:
            return {"action": "HOLD", "confidence": 0.0, "reasons": ["No data"]}

        close = pd.to_numeric(df["close"], errors="coerce")
        ema_fast = self._ema(close, 9).iloc[-1]
        ema_slow = self._ema(close, 21).iloc[-1]
        rsi_value = float(self._rsi(close, 14).iloc[-1])
        current = float(close.iloc[-1])
        prev = float(close.iloc[-2]) if len(close) > 1 else current
        price_change = ((current - prev) / prev) * 100 if prev else 0.0

        bullish = 0
        bearish = 0
        reasons = []

        if ema_fast > ema_slow:
            bullish += 2
            reasons.append("EMA bullish")
        else:
            bearish += 2
            reasons.append("EMA bearish")

        if 45 <= rsi_value <= 70:
            bullish += 2
            reasons.append("RSI supportive")
        elif rsi_value <= 35:
            bullish += 1
            reasons.append("RSI oversold")
        elif rsi_value >= 65:
            bearish += 2
            reasons.append("RSI overbought")
        else:
            bearish += 1
            reasons.append("RSI weak")

        if price_change > 0:
            bullish += 1
            reasons.append("Recent momentum positive")
        elif price_change < 0:
            bearish += 1
            reasons.append("Recent momentum negative")

        if bullish >= bearish + 3:
            confidence = min(0.95, 0.5 + (bullish - bearish) * 0.08)
            return {"action": "BUY", "confidence": round(confidence, 3), "reasons": reasons[:5]}
        if bearish >= bullish + 3:
            confidence = min(0.95, 0.5 + (bearish - bullish) * 0.08)
            return {"action": "SELL", "confidence": round(confidence, 3), "reasons": reasons[:5]}
        return {"action": "HOLD", "confidence": 0.0, "reasons": reasons[:5]}

    def _scan_symbol(self, symbol: str) -> Optional[Dict]:
        try:
            candles = self.client.get_klines(symbol=symbol, interval="1m", limit=100)
            if not candles:
                return None
            df = pd.DataFrame(candles, columns=[
                "open_time","open","high","low","close","volume","close_time","quote_asset_volume",
                "number_of_trades","taker_buy_base_asset_volume","taker_buy_quote_asset_volume","ignore"
            ])
            for col in ["open", "high", "low", "close", "volume"]:
                df[col] = pd.to_numeric(df[col], errors="coerce")
            signal = self._generate_signal(df)
            if signal["action"] == "HOLD":
                return None
            if signal["confidence"] < MIN_SIGNAL_STRENGTH:
                return None
            current_price = float(df["close"].iloc[-1])
            return {
                "symbol": symbol,
                "price": current_price,
                "signal": signal,
            }
        except Exception:
            return None

    def scan_market(self) -> List[Dict]:
        tickers = self.client.get_all_24hr_tickers()
        candidate_symbols = []

        for item in tickers:
            sym = item.get("symbol")
            if not sym or not sym.endswith("USDT"):
                continue
            if "UP" in sym or "DOWN" in sym or "BUSD" in sym:
                continue
            try:
                qv = float(item.get("quoteVolume", 0))
                if qv > 0:
                    candidate_symbols.append(sym)
            except Exception:
                continue

        candidate_symbols = sorted(candidate_symbols)[:25]
        signals = []
        for sym in candidate_symbols:
            signal = self._scan_symbol(sym)
            if signal:
                signals.append(signal)
        return signals

    def open_trade_if_needed(self, market_signals: List[Dict]):
        open_count = self.positions.count_open_positions()
        if open_count >= MAX_OPEN_POSITIONS:
            return

        for item in market_signals:
            sym = item["symbol"]
            if self.positions.has_open_position(sym):
                continue
            signal = item["signal"]
            action = signal["action"]
            if action not in {"BUY", "SELL"}:
                continue

            price = item["price"]
            if price <= 0:
                continue

            # open position in paper mode by default
            if action == "BUY":
                self.positions.open_position(
                    symbol=sym,
                    side="LONG",
                    entry_price=price,
                    stop_loss=price * (1 - STOP_LOSS_PERCENT / 100.0),
                    take_profit=price * (1 + TAKE_PROFIT_PERCENT / 100.0),
                    quantity=1.0,
                    confidence=signal["confidence"],
                    reasons=signal["reasons"],
                )
            else:
                self.positions.open_position(
                    symbol=sym,
                    side="SHORT",
                    entry_price=price,
                    stop_loss=price * (1 + STOP_LOSS_PERCENT / 100.0),
                    take_profit=price * (1 - TAKE_PROFIT_PERCENT / 100.0),
                    quantity=1.0,
                    confidence=signal["confidence"],
                    reasons=signal["reasons"],
                )

    def run_loop(self):
        last_scan = 0
        while True:
            now = time.time()
            if now - last_scan >= MARKET_SCAN_INTERVAL:
                signals = self.scan_market()
                self.open_trade_if_needed(signals)
                last_scan = now
                self.logger.add_event({
                    "type": "SCAN",
                    "timestamp": datetime.utcnow().isoformat(),
                    "signals_found": len(signals),
                })

            self.positions.check_positions()  # runs every tick
            time.sleep(POSITION_CHECK_INTERVAL)


if __name__ == "__main__":
    engine = BotEngine()
    engine.run_loop()

