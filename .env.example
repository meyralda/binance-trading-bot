from __future__ import annotations

import logging
import sys

import pandas as pd

from binance_client import get_client
from config import (
    CANDLE_LIMIT,
    ENABLE_LIVE_TRADING,
    ENABLE_PAPER_TRADING,
    INITIAL_BALANCE_USDT,
    INTERVAL,
    MIN_BALANCE_USDT,
    POSITION_SIZE_PERCENT,
    RISK_PER_TRADE_PERCENT,
    STOP_LOSS_PERCENT,
    SYMBOL,
)
from indicators import df_from_klines
from risk_manager import build_trade_plan
from strategy import generate_signal


logging.basicConfig(level=logging.INFO, format="%(asctime)s | %(levelname)s | %(message)s")
logger = logging.getLogger(__name__)


def print_signal(signal):
    print("\n=== Current Trading Signal ===")
    print(f"Action: {signal.action}")
    print(f"Confidence: {signal.confidence:.2f}")
    print(f"Entry Price: {signal.entry_price}")
    print(f"Stop Loss: {signal.stop_loss}")
    print(f"Take Profit: {signal.take_profit}")
    print("Reasons:")
    for reason in signal.reasons:
        print(f"  - {reason}")
    print("============================\n")


def main():
    logger.info("Starting Binance trading bot...")
    logger.info(f"Symbol: {SYMBOL} | Interval: {INTERVAL} | Live trading: {ENABLE_LIVE_TRADING}")

    client = get_client()
    raw_klines = client.get_klines(symbol=SYMBOL, interval=INTERVAL, limit=CANDLE_LIMIT)
    df = df_from_klines(raw_klines)

    if df.empty:
        logger.error("No candle data retrieved from Binance. Check API connectivity and symbol settings.")
        sys.exit(1)

    signal = generate_signal(df)
    print_signal(signal)

    if signal.action == "HOLD":
        logger.info("No actionable signal. Nothing executed.")
        return

    if not ENABLE_PAPER_TRADING and not ENABLE_LIVE_TRADING:
        logger.info("No trade mode enabled. Configure ENABLE_PAPER_TRADING or ENABLE_LIVE_TRADING.")
        return

    if ENABLE_LIVE_TRADING:
        logger.warning("Live trading is enabled. The bot will submit real orders.")
        balance_usdt = client.get_balance("USDT")
        if balance_usdt < MIN_BALANCE_USDT:
            logger.warning(f"USDT balance too low for live trading: {balance_usdt}. Minimum required: {MIN_BALANCE_USDT}")
            return

        trade_plan = build_trade_plan(signal, balance_usdt, RISK_PER_TRADE_PERCENT)
        if trade_plan.quantity <= 0:
            logger.warning("Calculated quantity is zero or negative. No order will be submitted.")
            return

        if signal.action == "BUY":
            logger.info(f"Submitting BUY order: quantity={trade_plan.quantity}, price={signal.entry_price}")
            client.place_market_order(symbol=SYMBOL, side="BUY", quantity=trade_plan.quantity)
        elif signal.action == "SELL":
            logger.info(f"Submitting SELL order: quantity={trade_plan.quantity}, price={signal.entry_price}")
            client.place_market_order(symbol=SYMBOL, side="SELL", quantity=trade_plan.quantity)
        return

    logger.info("Paper trading mode active. No real Binance order submitted.")
    logger.info(f"Simulated trade: {signal.action} @ {signal.entry_price} with SL={signal.stop_loss} and TP={signal.take_profit}")


if __name__ == "__main__":
    main()
